# Server configuration
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5500

# Generate a long random value locally. Never commit a real secret.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Supabase PostgreSQL connections. Never commit real credentials.
# DATABASE_URL uses the transaction-mode pooler for application connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# DIRECT_URL uses the session/direct connection for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
